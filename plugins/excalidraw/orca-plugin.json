{
  "manifestVersion": 2,
  "id": "orca-excalidraw",
  "publisher": "stablyai",
  "name": "Excalidraw",
  "version": "2.2.0",
  "execution": "sandboxed-ui",
  "description": "Draw and edit .excalidraw diagrams, and .excalidraw.svg and .excalidraw.png images, right in Orca's editor.",
  "license": "MIT",
  "repository": "https://github.com/stablyai/orca-plugins/tree/main/plugins/excalidraw",
  "engines": {
    "orca": ">=1.4.248"
  },
  "contributes": {
    "customEditors": [
      {
        "id": "excalidraw",
        "title": "Excalidraw",
        "icon": "images/tab-icon.png",
        "extensions": [".excalidraw", ".excalidraw.json"],
        "entry": "editor/index.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "excalidraw-svg",
        "title": "Excalidraw",
        "icon": "images/tab-icon.png",
        "extensions": [".excalidraw.svg"],
        "entry": "editor/image.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "excalidraw-png",
        "title": "Excalidraw",
        "icon": "images/tab-icon.png",
        "extensions": [".excalidraw.png"],
        "entry": "editor/image.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      }
    ],
    "newFiles": [
      {
        "id": "drawing",
        "title": "New Excalidraw drawing",
        "extension": ".excalidraw",
        "template": "templates/empty.excalidraw",
        "icon": "images/tab-icon.png"
      }
    ]
  },
  "capabilities": [],
  "cover": {
    "path": "images/cover.png",
    "alt": "A hand-drawn architecture sketch of a web app, API gateway, services and database open in the Excalidraw editor"
  },
  "screenshots": [
    {
      "path": "images/editing.png",
      "alt": "A box in the sketch selected, with Excalidraw's stroke, fill and font options beside it",
      "caption": "Editing a diagram"
    },
    {
      "path": "images/dark.png",
      "alt": "The same sketch in Excalidraw's dark theme",
      "caption": "Follows Orca's dark theme"
    }
  ]
}
