{
  "scopeName": "source.asm",
  "name": "Assembly",
  "fileTypes": [
    "s",
    "S"
  ],
  "patterns": [
    {
      "include": "#comments-block"
    },
    {
      "include": "#c-preprocessor"
    },
    {
      "include": "#comments-line"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#immediates"
    },
    {
      "include": "#registers-generic"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments-block": {
      "patterns": [
        {
          "name": "comment.block.asm",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "c-preprocessor": {
      "patterns": [
        {
          "match": "^\\s*(#\\s*include)\\s+(<[^>]+>|\"[^\"]+\")",
          "captures": {
            "1": {
              "name": "keyword.control.preprocessor.include.asm"
            },
            "2": {
              "name": "string.quoted.other.header.asm"
            }
          }
        },
        {
          "name": "keyword.control.preprocessor.asm",
          "match": "^\\s*#\\s*(?:define|undef|if|ifdef|ifndef|elif|else|endif|pragma|error|warning|line)\\b"
        }
      ]
    },
    "comments-line": {
      "patterns": [
        {
          "name": "comment.line.double-slash.asm",
          "match": "//.*$"
        },
        {
          "name": "comment.line.semicolon.asm",
          "match": ";.*$"
        },
        {
          "name": "comment.line.at.asm",
          "match": "@.*$"
        },
        {
          "name": "comment.line.hash.asm",
          "match": "#.*$"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^\\s*(\\.[a-zA-Z_0-9]+)(:)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.local.asm"
            },
            "2": {
              "name": "punctuation.separator.label.asm"
            }
          }
        },
        {
          "match": "^\\s*([0-9]+)(:)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.numeric.asm"
            },
            "2": {
              "name": "punctuation.separator.label.asm"
            }
          }
        },
        {
          "match": "^\\s*([a-zA-Z_?$@][a-zA-Z0-9_?$@]*)(:)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.asm"
            },
            "2": {
              "name": "punctuation.separator.label.asm"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.asm",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.asm",
              "match": "\\\\(?:[abefnrtv\\\\'\"]|x[0-9a-fA-F]{2}|[0-7]{1,3})"
            }
          ]
        },
        {
          "name": "string.quoted.single.asm",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.asm",
              "match": "\\\\(?:[abefnrtv\\\\'\"]|x[0-9a-fA-F]{2}|[0-7]{1,3})"
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.directive.asm",
          "match": "(?i)\\.(?:text|data|bss|rodata|section|subsection|pushsection|popsection|previous|global|globl|local|extern|weak|hidden|protected|internal|type|size|symver|align|p2align|balign|org|byte|short|hword|word|int|long|quad|octa|float|single|double|ascii|asciz|string|string8|string16|string32|dc|ds|fill|space|skip|zero|comm|lcomm|common|set|equ|equiv|eqv|if|ifdef|ifndef|ifnotdef|ifc|ifnc|ifeq|ifne|iflt|ifle|ifgt|ifge|else|elseif|endif|macro|endm|exitm|rept|endr|irp|irpc|purgem|altmacro|noaltmacro|include|incbin|list|nolist|title|ident|version|file|loc|loc_mark_labels|cfi_startproc|cfi_endproc|cfi_def_cfa|cfi_def_cfa_offset|cfi_def_cfa_register|cfi_offset|cfi_adjust_cfa_offset|cfi_register|cfi_remember_state|cfi_restore_state|cfi_restore|cfi_undefined|cfi_same_value|cfi_escape|cfi_signal_frame|cfi_personality|cfi_lsda|cfi_return_column|cfi_sections|abort|error|warning|print|fail|end|func|endfunc|arm|thumb|thumb_func|syntax|arch|cpu|fpu|code|even|ltorg|pool|req|unreq)\\b"
        }
      ]
    },
    "immediates": {
      "patterns": [
        {
          "name": "constant.numeric.immediate.gas.asm",
          "match": "\\$(?:0x[0-9a-fA-F]+|[0-9]+|[a-zA-Z_][a-zA-Z0-9_]*)"
        },
        {
          "name": "constant.numeric.immediate.arm.asm",
          "match": "#(?:0x[0-9a-fA-F]+|-?[0-9]+|:[a-zA-Z0-9_]+:)"
        }
      ]
    },
    "registers-generic": {
      "patterns": [
        {
          "name": "variable.language.register.asm",
          "match": "(?i)%[a-zA-Z0-9_]+|\\b(?:r[0-9]{1,2}|x[0-9]{1,2}|w[0-9]{1,2}|[a-d][xhl]|[er][a-d]x|[er]?[sbd]p|[er]?[sbd]i|pc|lr|sp|cpsr|spsr|xzr|wzr)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.asm",
          "match": "[-+*\\/%=&|~^!<>]=?"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.asm",
          "match": "(?i)\\b(?:0x[0-9a-fA-F]+|[0-9][0-9a-fA-F]*h)\\b"
        },
        {
          "name": "constant.numeric.binary.asm",
          "match": "(?i)\\b(?:0b[01]+|[01]+b)\\b"
        },
        {
          "name": "constant.numeric.octal.asm",
          "match": "(?i)\\b0[0-7]+\\b"
        },
        {
          "name": "constant.numeric.decimal.asm",
          "match": "\\b[0-9]+\\b"
        }
      ]
    }
  }
}