{
  "manifestVersion": 2,
  "id": "orca-docx",
  "publisher": "stablyai",
  "name": "Word Document Viewer",
  "version": "2.0.0",
  "execution": "sandboxed-ui",
  "description": "Read Word (.docx) documents in Orca: page layout, find, tracked changes, comments, links and zoom.",
  "license": "MIT",
  "repository": "https://github.com/stablyai/orca-plugins/tree/main/plugins/docx",
  "engines": {
    "orca": ">=1.4.248"
  },
  "contributes": {
    "customEditors": [
      {
        "id": "docx",
        "title": "Word Preview",
        "extensions": [".docx"],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes"
      }
    ]
  },
  "capabilities": []
}
