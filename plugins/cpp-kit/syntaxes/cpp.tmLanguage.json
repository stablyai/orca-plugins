{
  "scopeName": "source.cpp.inlines",
  "name": "C++ Inlines & Templates",
  "fileTypes": [
    "ipp",
    "inl",
    "tpp",
    "tcc",
    "ixx",
    "cppm"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#templates-concepts"
    },
    {
      "include": "#storage-specifiers"
    },
    {
      "include": "#declaration-keywords"
    },
    {
      "include": "#control-keywords"
    },
    {
      "include": "#operator-overload"
    },
    {
      "include": "#operator-keywords"
    },
    {
      "include": "#builtin-constants"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#standard-types"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#scope-resolution"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.cpp",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.cpp",
          "match": "//.*$"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "match": "^\\s*(#\\s*include)\\s+(<[^>]+>|\"[^\"]+\")",
          "captures": {
            "1": {
              "name": "keyword.control.preprocessor.include.cpp"
            },
            "2": {
              "name": "string.quoted.other.header.cpp"
            }
          }
        },
        {
          "name": "keyword.control.preprocessor.cpp",
          "match": "^\\s*#\\s*(?:define|undef|if|ifdef|ifndef|elif|else|endif|pragma|error|warning|line)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.cpp",
          "begin": "R\"([a-zA-Z0-9_]*)\\(",
          "end": "\\)\\1\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.cpp"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.cpp"
            }
          }
        },
        {
          "name": "string.quoted.double.cpp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cpp",
              "match": "\\\\(?:['\"?\\\\abfnrtv]|[0-7]{1,3}|x[0-9a-fA-F]+|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
            }
          ]
        },
        {
          "name": "string.quoted.single.cpp",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.cpp",
              "match": "\\\\(?:['\"?\\\\abfnrtv]|[0-7]{1,3}|x[0-9a-fA-F]+)"
            }
          ]
        }
      ]
    },
    "templates-concepts": {
      "patterns": [
        {
          "name": "keyword.other.template.cpp",
          "match": "\\b(?:template|typename|concept|requires)\\b"
        }
      ]
    },
    "storage-specifiers": {
      "patterns": [
        {
          "name": "storage.modifier.cpp",
          "match": "\\b(?:inline|constexpr|consteval|constinit|static|extern|thread_local|const|volatile|mutable|explicit|virtual|override|final|noexcept|export)\\b"
        }
      ]
    },
    "declaration-keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.cpp",
          "match": "\\b(?:class|struct|union|enum|namespace|using|typedef|auto|decltype|friend)\\b"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.cpp",
          "match": "\\b(?:if|else|for|while|do|switch|case|default|return|break|continue|goto|try|catch|throw|co_await|co_return|co_yield)\\b"
        }
      ]
    },
    "operator-overload": {
      "patterns": [
        {
          "match": "\\b(operator)\\s*(\\[\\]|\\(\\)|[-+*/%^&|~!=<>]=?|<<=?|>>=?|->\\*?|&&|\\|\\||\\+\\+|--|co_await|[a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.cpp"
            },
            "2": {
              "name": "entity.name.function.operator.cpp"
            }
          }
        }
      ]
    },
    "operator-keywords": {
      "patterns": [
        {
          "name": "keyword.operator.cpp",
          "match": "\\b(?:operator|new|delete|sizeof|alignof|alignas|typeid|static_cast|dynamic_cast|const_cast|reinterpret_cast|static_assert)\\b"
        }
      ]
    },
    "builtin-constants": {
      "patterns": [
        {
          "name": "constant.language.cpp",
          "match": "\\b(?:true|false|nullptr|this|NULL)\\b"
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "storage.type.built-in.cpp",
          "match": "\\b(?:void|bool|char|wchar_t|char8_t|char16_t|char32_t|short|int|long|signed|unsigned|float|double)\\b"
        }
      ]
    },
    "standard-types": {
      "patterns": [
        {
          "name": "storage.type.standard.cpp",
          "match": "\\b(?:std|size_t|ptrdiff_t|intptr_t|uintptr_t|[u]?int(?:8|16|32|64)_t|byte|string|string_view|vector|array|deque|list|forward_list|map|unordered_map|set|unordered_set|multimap|multiset|tuple|pair|optional|variant|any|span|unique_ptr|shared_ptr|weak_ptr|function|is_arithmetic(?:_v)?|is_same(?:_v)?|is_base_of(?:_v)?|decay(?:_t)?|remove_cvref(?:_t)?|enable_if(?:_t)?)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.cpp"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.cpp",
          "match": "\\b0[xX][0-9a-fA-F]+(?:'[0-9a-fA-F]+)*(?:[uU]?[lL]{0,2}|[lL]{1,2}[uU]?)?\\b"
        },
        {
          "name": "constant.numeric.binary.cpp",
          "match": "\\b0[bB][01]+(?:'[01]+)*(?:[uU]?[lL]{0,2}|[lL]{1,2}[uU]?)?\\b"
        },
        {
          "name": "constant.numeric.float.cpp",
          "match": "\\b[0-9]+(?:'[0-9]+)*\\.[0-9]+(?:'[0-9]+)*(?:[eE][+-]?[0-9]+)?[fFlL]?\\b"
        },
        {
          "name": "constant.numeric.decimal.cpp",
          "match": "\\b[0-9]+(?:'[0-9]+)*(?:[eE][+-]?[0-9]+)?[fFlL]?|[0-9]+(?:'[0-9]+)*(?:[uU]?[lL]{0,2}|[lL]{1,2}[uU]?)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cpp",
          "match": "[-+*\\/%=&|~^!<>]=?|->|\\.|&&|\\|\\||\\+\\+|--|<<=?|>>=?|<=>"
        }
      ]
    },
    "scope-resolution": {
      "patterns": [
        {
          "name": "punctuation.separator.namespace.cpp",
          "match": "::"
        }
      ]
    }
  }
}