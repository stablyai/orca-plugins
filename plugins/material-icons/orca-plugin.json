{
  "manifestVersion": 2,
  "id": "orca-material-icons",
  "publisher": "stablyai",
  "name": "Material Icon Theme for Orca",
  "version": "1.1.0",
  "execution": "data",
  "description": "Colorful file and folder icons from Material Icon Theme for about 470 common file types and names and 19 common folders, with a variant for light themes.",
  "license": "MIT",
  "repository": "https://github.com/stablyai/orca-plugins/tree/main/plugins/material-icons",
  "engines": {
    "orca": ">=1.4.245"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "material",
        "title": "Material Icons",
        "path": "icons/theme.json"
      },
      {
        "id": "material-light",
        "title": "Material Icons (Light)",
        "path": "icons/theme-light.json"
      }
    ]
  },
  "capabilities": []
}
